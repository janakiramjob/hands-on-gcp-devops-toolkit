{
 "uid": "kafka-keda-lab",
 "title": "Kafka + KEDA lab",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "kafka",
  "keda"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Consumer lag vs consumer replicas",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "consumer replicas (right)"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "custom.drawStyle",
        "value": "line"
       },
       {
        "id": "custom.lineInterpolation",
        "value": "stepAfter"
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kafka_consumergroup_lag{consumergroup=\"orders-consumer\",topic=\"orders\"})",
     "legendFormat": "total lag (left)"
    },
    {
     "refId": "B",
     "expr": "sum(kube_deployment_status_replicas{namespace=\"demo\",deployment=\"consumer\"})",
     "legendFormat": "consumer replicas (right)"
    }
   ],
   "description": "Lag from Kafka Exporter; replicas from kube-state-metrics. Watch replicas follow lag 0 -> N -> 0."
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "KEDA scaler value",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(keda_scaler_metrics_value{scaledObject=\"consumer-scaler\"})",
     "legendFormat": "scaler value (lag)"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "KEDA scaler errors",
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(keda_scaler_detail_errors_total[5m])) or sum(increase(keda_scaler_errors_total[5m])) or vector(0)",
     "legendFormat": "errors / 5m"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Messages in per second, per topic",
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic!~\"__.*\"}[1m]))",
     "legendFormat": "{{topic}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Lag per partition (orders)",
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (partition) (kafka_consumergroup_lag{consumergroup=\"orders-consumer\",topic=\"orders\"})",
     "legendFormat": "p{{partition}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Broker CPU (cores)",
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"kafka\",pod=~\"demo-dual-.*\",container=\"kafka\"}[2m]))",
     "legendFormat": "broker cpu"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Broker memory (working set)",
   "gridPos": {
    "x": 8,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(container_memory_working_set_bytes{namespace=\"kafka\",pod=~\"demo-dual-.*\",container=\"kafka\"})",
     "legendFormat": "broker memory"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Kafka volume usage",
   "gridPos": {
    "x": 16,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kubelet_volume_stats_used_bytes{namespace=\"kafka\",persistentvolumeclaim=~\"data-.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"kafka\",persistentvolumeclaim=~\"data-.*\"}",
     "legendFormat": "{{persistentvolumeclaim}}"
    }
   ]
  }
 ]
}